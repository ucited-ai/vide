vp staged

# Dead-code gate. Reports the repo's known dead code and fails the commit only when
# this commit created some. Roughly 0.6s on a normal staged change; see
# DEAD-CODE-CHECK-DESIGN.md. Bypass one commit with VIDE_SKIP_DEAD_CODE=1.
#
# Guarded because core.hooksPath is absolute and shared: a commit made in a linked
# worktree runs the main checkout's copy of this file with the worktree as cwd, so
# the script legitimately may not exist there yet.
if [ -f scripts/dead-code/check.ts ]; then
  node scripts/dead-code/check.ts --staged
fi

# Theme-token gate, the mirror of the one above: that one asks whether a token is
# declared and never used, this one whether a colour or a text size is used and
# never declared. Fails the commit only on values this commit put outside the
# theme. Bypass one commit with VIDE_SKIP_THEME_TOKENS=1.
#
# Guarded for the same reason as the dead-code gate.
if [ -f scripts/theme-tokens/check.ts ]; then
  node scripts/theme-tokens/check.ts --staged
fi
